# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle's own build output (AGP 9 writes an /android/build tree next to
# the module ones) -- regenerated by every build, never source.
/android/build/
/android/.gradle/
/android/.kotlin/

# Go core (native/): build_android.ps1 regenerates these, not source.
/android/app/src/main/jniLibs/
native/*.so
native/*.h
native/native
native/native.exe
native/*.test
native/*_android

# Firebase config -- operator-specific, not committed. See README.md's
# "Setting up FCM" section for where to get it.
/android/app/google-services.json

# Browser "Save As" clutter from viewing design references, not itself
# a design asset -- keep only the actual gfx/*.png source layers.
gfx/*.html
gfx/*_files/
/local-gfx

# Personal Claude Code workflow notes -- not part of the public project.
CLAUDE.md

# Local, machine-specific VS Code build/deploy tasks -- not part of the
# public project (paths and device targets are personal).
.vscode/tasks.json
